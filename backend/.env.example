# Database
MONGO_URI=
FIREBASE_DATABASE_URL=

# Authentication
JWT_SECRET=
SESSION_SECRET=

# Midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# App
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
ENABLE_DEBUG_TOKEN_LOGGER=false

# Rate limit
MODE=ON
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600

# Gunakan Mode ON untuk production dan OFF untuk development agar tidak terkena rate limit.
# Atur waktu rate_limit_window_ms dalam milidetik (ms) 
# Atur rate_limit_max untuk jumlah maksimum permintaan yang diizinkan untuk melakukan reqeuest dalam jangka waktu rate_limit_window_ms.