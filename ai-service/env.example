# ai-service/.env
# Copy file ini dan isi MONGO_URI sesuai environment

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/Aplikasi_Kasir?retryWrites=true&w=majority

# Service config
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_SERVICE_DEBUG=false

# CORS origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000

# BI Thresholds
ANOMALI_ZSCORE_THRESHOLD=2.5
PENURUNAN_THRESHOLD_PCT=15.0
CASH_RUNWAY_MIN_DAYS=7